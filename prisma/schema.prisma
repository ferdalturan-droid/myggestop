// Myggestop – Prisma schema (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====== ARKITEKTUR-OMBYGNING FASE 1 ======
// Alt herunder markeret "FASE 1" er tilfoejet additivt jf.
// Myggestop - Arkitektur-specifikation.md. Intet eksisterende felt er
// fjernet eller aendret i denne fase - kun nye tabeller/felter/enums
// tilfoejet. Ingen eksisterende kode laeser/skriver dem endnu.

// FASE 1 (§3.1): rollefelt paa AdminUser. Bruges foerst af middleware/API i Fase 2.
enum Role {
  COORDINATOR
  BUILDER
  INSTALLER
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Administrator")
  role         Role     @default(COORDINATOR)
  resetToken       String?   @unique // FASE 3: "glemt adgangskode"-flow
  resetTokenExpiry DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // RUNDE 5: en navngiven Bygger/Installatør kan tildeles en konkret
  // kalenderaftale ("der er ikke et generelt 'bygger', hvis der er flere
  // end 1 skal de vises separat da alle har deres egne kalender").
  appointments Appointment[] @relation("AssignedAppointments")
}

// FASE 1 (§3.2): Lead ligger foran Order. Al kunde-/kontaktdata for et
// lead bor her. For eksisterende Order-raekker (fra foer ombygningen)
// oprettes et tilsvarende Lead af migreringsscriptet
// scripts/migrate-orders-to-leads.ts, jf. §7 punkt 5 og §10.3-10.5.
enum LeadStage {
  NYT_LEAD
  KONTAKTET
  OPMAALING_BOOKET
  TILBUD_GIVET
  BEKRAEFTET
}

model Lead {
  id             String    @id @default(cuid())
  leadNumber     String    @unique // fx MYG-2026-0001 - samme loebenummer som Order.orderNumber ved forfremmelse, se §3.6
  stage          LeadStage @default(NYT_LEAD)

  firstName      String
  lastName       String
  phone          String
  email          String
  address        String
  postalCode     String
  city           String

  // RUNDE 8 (delta §1/§3 - "ikke frit tekstfelt men en liste rapporterings-
  // mulighed for at se hvilken platform lead kom fra"): faste, rapporterbare
  // kilde-kategorier - men BEVIDST stadig en almindelig String i selve
  // databasen (ikke et Postgres-enum). Kategorierne haandhaeves i
  // applikationslaget (src/lib/leadSource.ts, samme moenster som fx
  // Order.paymentStatus allerede bruger). Grunden: at konvertere en
  // eksisterende tekst-kolonne til en enum-type kraever at ALLE
  // eksisterende raekker allerede matcher praecis en af enum-vaerdierne,
  // ellers fejler "prisma db push" haardt for HELE databasen (oplevet i
  // praksis under denne rundes forsoeg) - en unoedvendig risiko for en
  // regel der lige saa sikkert kan haandhaeves i koden.
  source         String    @default("HJEMMESIDE")
  productSummary String    @default("")
  note           String    @default("")

  // RUNDE 8 (delta §5): et lead der sagde nej maa ikke blive vaerende for
  // evigt i aktive lister/notifikationer.
  lostAt         DateTime?

  quotePriceDkk  Float?
  confirmedAt    DateTime?

  // RUNDE 2 (§3.2/§6.2/§11.2): to-trins opmålingsbooking + eksplicit
  // opmålings-signering. expectedMeasuringWeekLabel bruges KUN mens der
  // endnu ikke er fundet en reel slot; expectedMeasuringDate saettes naar
  // en Appointment (type=MAALING) rent faktisk er booket. measuredAt er
  // den EKSPLICITTE "faerdig opmaalt"-markering fra installatoeren -
  // driver deriveLeadStatus, IKKE tilstedevaerelsen af udfyldte maal.
  expectedMeasuringDate      DateTime?
  expectedMeasuringWeekLabel String?
  measuredAt                 DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  measurements   Measurement[]
  appointments   Appointment[]
  notes          Note[]
  order          Order?

  @@index([stage])
}

// FASE 1 (§3.4): erstatter paa sigt den ustrukturerede JSON i Setting
// (unified_saved_records). Bruges foerst rigtigt fra Fase 6.
model Measurement {
  id          String   @id @default(cuid())
  // RUNDE 9 ("manuel ordre skal kunne indtaste alle info pr. produkt inkl.
  // mål/type... og en manuel ordre må ikke oprette et lead"): leadId er nu
  // valgfri, og et Measurement kan i stedet kobles direkte til en Order via
  // orderId - samme dobbelt-valgfri-FK-mønster som Appointment/Note allerede
  // bruger. En "rigtig" (lead-baseret) ordre bruger fortsat leadId; en
  // manuel bypass-ordre (uden lead) bruger orderId direkte.
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemNumber  Int
  roomName    String   @default("")
  productType String
  widthMm     Int?     // NULL = forventet, endnu ikke opmaalt
  heightMm    Int?
  colorName   String   @default("")
  comment     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // FASE 6 (§8.6): produktionsberegnerens linje-konfiguration, saa en
  // ordre-koblet beregner-session kan laese/skrive DIREKTE til denne
  // raekke (samme faktum, ingen "importeret snapshot" - jf. accept-
  // kriterium i §9). Kun brugt naar ImalatCalc aabnes med ?orderId=,
  // paavirker IKKE den gamle Setting-blob-baserede "Gemte ordrer".
  tur         String   @default("SINEKLIK") // SINEKLIK | PERDE | KOMBI
  sys         String   @default("1,9")      // 1,9 | 2,8
  tip         String   @default("TEK")      // TEK | DUBLE
  layout      String   @default("YANA")     // YANA | AŞAĞI (Row.model i ImalatCalc)
  kanat       String   @default("HAREKETLI") // HAREKETLI | SABIT
  adet        Int      @default(1)
  // RUNDE 8 (delta §7 - "ingen bruger indtaster nogensinde en dato"):
  // erstatter den tidligere rene boolean "done" - et tidsstempel sat af
  // en toggle-handling (Byggeren tjekker linjen af i Produktion-fanen),
  // ikke et frit flueben uden historik. NULL = ikke bygget endnu.
  builtAt     DateTime?

  @@index([leadId])
  @@index([orderId])
}

// FASE 1 (§3.3): nye OrderStage-vaerdier tilfoejet ved siden af den
// eksisterende OrderStatus (som IKKE fjernes i denne fase - se §7/§10.1:
// OrderForm.tsx og /admin/ordrer bruger stadig status indtil Fase 3/6).
enum OrderStage {
  KOE
  I_PRODUKTION
  BETALT
  ANMELDT
}

// Et produkt (produkttype) som kan bestilles. Redigeres fra admin.
model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  shortText       String   @default("")
  description     String   @default("")
  pricePerSqm     Float    @default(500)   // DKK pr. m2
  maxWidthMm      Int      @default(2500)  // max bredde i mm
  maxHeightMm     Int      @default(2500)
  minWidthMm      Int      @default(150)
  minHeightMm     Int      @default(150)
  // Hvis bredde overstiger denne vaerdi -> klassificeres som Dobbeltdor
  doubleDoorThresholdMm Int? // null = ingen dobbeltdor-logik
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  imageUrl        String   @default("")
  features        Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]
}

// Farver der kan vaelges + evt. tillaeg
model Color {
  id          String  @id @default(cuid())
  name        String
  hex         String  @default("#ffffff")
  surchargePerSqm Float @default(0) // DKK pr. m2 tillaeg
  isStandard  Boolean @default(false) // standardfarve = intet tillaeg
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

enum OrderStatus {
  NY            // Ny ordre
  UNDER_BEHANDLING // Under behandling
  TILBUD_SENDT  // Tilbud sendt
  AFVENTER_KUNDE // Afventer kunde
  AFSLUTTET     // Afsluttet
  ANNULLERET    // Annulleret
}

// RUNDE 9 ("det skal være muligt at vælge om montering skal laves... det
// skal også være muligt at vælge 'afhenter selv' eller 'fragtet'"):
// hvordan kunden får ordren, NÅR den er færdig i produktion - adskilt fra
// wantsInstallation (som styrer OM installatøren monterer den hos kunden).
// En ordre der ikke skal monteres, skal enten afhentes af kunden selv
// eller sendes med fragt (med en manuelt indtastet fragtpris).
enum DeliveryMethod {
  AFHENTER_SELV
  FRAGTES
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique // MYG-2026-0001
  status        OrderStatus @default(NY)

  // Kundeoplysninger
  firstName     String
  lastName      String
  phone         String
  email         String
  address       String
  postalCode    String
  city          String

  wantsInstallation Boolean @default(false) // true = montering, false = kun levering
  // RUNDE 9: kun relevant naar wantsInstallation=false - hvordan kunden
  // faar ordren. shippingCost indtastes manuelt af Koordinator (fragtpris
  // varierer, beregnes ikke automatisk - se allerede eksisterende
  // "Fragt beregnes ikke automatisk" i Priser & gebyrer).
  deliveryMethod    DeliveryMethod @default(AFHENTER_SELV)
  shippingCost      Float?
  // RUNDE 9: post-produktion-forgreningens "modstykke" til installedAt, når
  // ordren IKKE skal monteres - Koordinator markerer selv hvornår den er
  // afhentet/fragtet, da installatørens del af processen slet ikke gælder
  // for denne ordre.
  handedOverAt      DateTime?
  // RUNDE 9: kilde-kategori ogsaa paa selve ordren (ikke kun Lead) - en
  // manuel bypass-ordre opretter ikke laengere noget lead (se nedenfor), saa
  // kilde-rapportering ville ellers gaa tabt for netop disse ordrer.
  // Udfyldes fra lead.source ved forfremmelse, eller direkte ved manuel
  // ordre-oprettelse.
  source            String   @default("")
  note          String   @default("")

  // Prissammendrag (oprettet ud fra indstillinger paa bestillingstidspunktet)
  productsTotal     Float @default(0)
  installationTotal Float @default(0)
  estimatedTotal    Float @default(0)
  currency          String @default("DKK")

  items         OrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // FASE 1 (§3.3) - additive felter til den nye Lead/Order-model.
  // leadId er nullable indtil migreringsscriptet har koert (og indtil
  // Fase 3, hvor nye ordrer foerst begynder at faa en reel Lead).
  stage               OrderStage @default(KOE)
  leadId              String?    @unique
  lead                Lead?      @relation(fields: [leadId], references: [id])
  // RUNDE 8 ("vi gemmer ikke information der ikke bruges" - delta §2, samme
  // princip anvendt bredere): estReadyDate/estReadyWeekLabel/
  // promisedInstallDate blev udelukkende sat af den nu fjernede automatiske
  // kalender-booking fra ordre-siden og blev aldrig vist andre steder -
  // fjernet i stedet for at lade dem staa som daed data.
  // RUNDE 8 (delta §2 - "vi gemmer ikke information der ikke bruges"):
  // productionStartedAt ("i gang")-feltet er fjernet helt sammen med
  // knappen der satte det - readyAt er og var den egentlige kendsgerning.
  readyAt             DateTime?
  installedAt         DateTime?
  paymentStatus       String     @default("IKKE_SENDT") // IKKE_SENDT | SENDT | BETALT
  paidAt              DateTime?
  reviewLinkSentAt    DateTime?
  reviewReceived      Boolean    @default(false)
  // Ikke i spec'ens §3.3-model, men noedvendig for at kunne bevare
  // ANNULLERET-historik uden datatab naar OrderStatus paa sigt fjernes
  // (se §7 punkt 5 - "brug dit skoen her, men dokumentér valget").
  cancelledAt         DateTime?
  appointments        Appointment[]
  notes               Note[]
  // RUNDE 9: en manuel bypass-ordre har INGEN Lead (se Measurement.orderId
  // ovenfor) - dens produktlinjer/mål ligger derfor direkte her i stedet.
  // For en normal (lead-baseret) ordre forbliver order.lead.measurements
  // fortsat sandhedskilden, uaendret.
  measurements        Measurement[]

  @@index([status])
  @@index([stage])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  roomName    String  // Rum navn (Kokken, Stue ...)
  productName String  // snapshot af produktnavn
  widthMm     Int
  heightMm    Int
  colorName   String  @default("")
  comment     String  @default("")

  isDoubleDoor Boolean @default(false)
  areaSqm      Float   @default(0) // afrundet m2 (op til naermeste 0,5)
  lineTotal    Float   @default(0) // pris for denne linje (ekskl. montering)

  createdAt   DateTime @default(now())
}

// Galleri (billeder og videoer). type = "image" | "video"
model GalleryItem {
  id        String  @id @default(cuid())
  type      String  @default("image")
  category  String  @default("vinduer") // vinduer | dore | dobbeltdore | plisse | videoer
  url       String
  thumbUrl  String  @default("")
  title     String  @default("")
  alt       String  @default("")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
}

// Fleksibel key/value store til indstillinger, priser, indhold og SEO.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Beskeder fra kontaktformularen
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Til generering af fortlobende ordrenumre pr. aar
model OrderCounter {
  year  Int @id
  count Int @default(0)
}

// FASE 1 (§3.5): nye kalenderfelter tilfoejet additivt ved siden af de
// eksisterende (day/time/customer/phone/address/note), som stadig er
// dem randevuAl() i ImalatCalc.tsx bruger indtil Fase 5. De nye felter
// er alle nullable, saa eksisterende raekker forbliver gyldige.
enum AppointmentType {
  MAALING
  INSTALLATION
  // RUNDE 3: opgavetype til kalenderens "+ Ny aftale" (kun Coordinator maa
  // oprette).
  // RUNDE 8 (delta §8 + "kalenderaftaler kun oprettes fra Kalender-siden"):
  // PRODUKTION oprettes IKKE laengere automatisk - Coordinator opretter den
  // manuelt fra Kalender-siden ligesom Opmåling/Installation, og kobler
  // den til ordren via soegefeltet der allerede findes der.
  PRODUKTION
  // RUNDE 8: IKKE laengere valgbar i UI'en (fjernet fra APPT_TYPE_OPTIONS,
  // se appointmentOptions.ts) - men BEVIDST bevaret her i selve enum'et.
  // Ældre, allerede oprettede aftaler i produktions-databasen har denne
  // vaerdi, og at fjerne en enum-vaerdi der stadig er i brug faar
  // "prisma db push" til at fejle haardt (Postgres kan ikke konvertere
  // eksisterende raekker til en enum-type der ikke laengere indeholder
  // deres vaerdi). At beholde vaerdien i skemaet er risikofrit; det er
  // UI-tilgaengeligheden der er fjernet, jf. Runde 5 §G3.
  ORDRE
}

enum AppointmentStatus {
  TENTATIVE
  CONFIRMED
}

enum Resource {
  BUILDER
  INSTALLER
}

model Appointment {
  id        String   @id @default(cuid())
  day       String   // "2026-05-12"
  time      String?  // "17:00" - RUNDE 2: nullable, saa en fri kalenderpost
                      // (ingen Lead/Order, se §Q6) kan oprettes uden et tidspunkt.
                      // randevuAl()/den gamle flade liste saetter stadig altid tid.
  customer  String
  phone     String   @default("")
  address   String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  // FASE 1 - nye felter, ubrugte af eksisterende kode indtil Fase 5.
  type      AppointmentType?
  status    AppointmentStatus?
  resource  Resource?
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  // RUNDE 5 (§"Koordinator indsætter dette i Installators (specifik
  // person) kalender"): den konkrete navngivne Bygger/Installatør aftalen
  // er lagt hos - IKKE kun den generiske rolle (Resource). Nullable, saa
  // ældre aftaler oprettet før dette felt fortsat er gyldige (de vises
  // fortsat via resource-fallback, se /api/kalender).
  assignedUserId String?
  assignedUser   AdminUser? @relation("AssignedAppointments", fields: [assignedUserId], references: [id])

  @@index([day])
  @@index([day, resource])
  @@index([assignedUserId])
}

// RUNDE 8 ("notat skal være generelt men også muligt at vælge hvilken
// proces det omhandler så det ikke er blandet - notater fra lead-
// processen kan godt contradict med notater fra installations-processen"):
// et notat pr. LEAD (bevares ved forfremmelse til ordre) ELLER pr. ORDRE
// (til den manuelle "bypass"-ordre uden noget lead, se §11.5/delta §8),
// aldrig begge - samme dobbelt-nullable moenster som Appointment allerede
// bruger. Flere notater kan findes pr. kategori (en lille logget liste,
// ikke ét delt tekstfelt flere roller kan overskrive for hinanden).
enum NoteCategory {
  LEAD          // opmåling/pris/aftaler før ordren findes
  PRODUKTION    // til Byggeren
  INSTALLATION  // til Installatøren
  GENERELT      // tværgående / passer ikke i de andre
}

model Note {
  id         String       @id @default(cuid())
  category   NoteCategory @default(GENERELT)
  leadId     String?
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId   String?
  authorName String       @default("")
  body       String
  createdAt  DateTime     @default(now())

  @@index([leadId])
  @@index([orderId])
}
