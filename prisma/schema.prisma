// Myggestop – Prisma schema (PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====== ARKITEKTUR-OMBYGNING FASE 1 ======
// Alt herunder markeret "FASE 1" er tilfoejet additivt jf.
// Myggestop - Arkitektur-specifikation.md. Intet eksisterende felt er
// fjernet eller aendret i denne fase - kun nye tabeller/felter/enums
// tilfoejet. Ingen eksisterende kode laeser/skriver dem endnu.

// FASE 1 (§3.1): rollefelt paa AdminUser. Bruges foerst af middleware/API i Fase 2.
enum Role {
  COORDINATOR
  BUILDER
  INSTALLER
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Administrator")
  role         Role     @default(COORDINATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// FASE 1 (§3.2): Lead ligger foran Order. Al kunde-/kontaktdata for et
// lead bor her. For eksisterende Order-raekker (fra foer ombygningen)
// oprettes et tilsvarende Lead af migreringsscriptet
// scripts/migrate-orders-to-leads.ts, jf. §7 punkt 5 og §10.3-10.5.
enum LeadStage {
  NYT_LEAD
  KONTAKTET
  OPMAALING_BOOKET
  TILBUD_GIVET
  BEKRAEFTET
}

model Lead {
  id             String    @id @default(cuid())
  leadNumber     String    @unique // fx MYG-2026-0001 - samme loebenummer som Order.orderNumber ved forfremmelse, se §3.6
  stage          LeadStage @default(NYT_LEAD)

  firstName      String
  lastName       String
  phone          String
  email          String
  address        String
  postalCode     String
  city           String

  source         String    @default("") // "Hjemmeside", "Telefon", "Henvisning", "Migreret" osv.
  productSummary String    @default("")
  note           String    @default("")

  quotePriceDkk  Float?
  confirmedAt    DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  measurements   Measurement[]
  appointments   Appointment[]
  order          Order?

  @@index([stage])
}

// FASE 1 (§3.4): erstatter paa sigt den ustrukturerede JSON i Setting
// (unified_saved_records). Bruges foerst rigtigt fra Fase 6.
model Measurement {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  itemNumber  Int
  roomName    String   @default("")
  productType String
  widthMm     Int?     // NULL = forventet, endnu ikke opmaalt
  heightMm    Int?
  colorName   String   @default("")
  comment     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
}

// FASE 1 (§3.3): nye OrderStage-vaerdier tilfoejet ved siden af den
// eksisterende OrderStatus (som IKKE fjernes i denne fase - se §7/§10.1:
// OrderForm.tsx og /admin/ordrer bruger stadig status indtil Fase 3/6).
enum OrderStage {
  KOE
  I_PRODUKTION
  BETALT
  ANMELDT
}

// Et produkt (produkttype) som kan bestilles. Redigeres fra admin.
model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  shortText       String   @default("")
  description     String   @default("")
  pricePerSqm     Float    @default(500)   // DKK pr. m2
  maxWidthMm      Int      @default(2500)  // max bredde i mm
  maxHeightMm     Int      @default(2500)
  minWidthMm      Int      @default(150)
  minHeightMm     Int      @default(150)
  // Hvis bredde overstiger denne vaerdi -> klassificeres som Dobbeltdor
  doubleDoorThresholdMm Int? // null = ingen dobbeltdor-logik
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  imageUrl        String   @default("")
  features        Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]
}

// Farver der kan vaelges + evt. tillaeg
model Color {
  id          String  @id @default(cuid())
  name        String
  hex         String  @default("#ffffff")
  surchargePerSqm Float @default(0) // DKK pr. m2 tillaeg
  isStandard  Boolean @default(false) // standardfarve = intet tillaeg
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

enum OrderStatus {
  NY            // Ny ordre
  UNDER_BEHANDLING // Under behandling
  TILBUD_SENDT  // Tilbud sendt
  AFVENTER_KUNDE // Afventer kunde
  AFSLUTTET     // Afsluttet
  ANNULLERET    // Annulleret
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique // MYG-2026-0001
  status        OrderStatus @default(NY)

  // Kundeoplysninger
  firstName     String
  lastName      String
  phone         String
  email         String
  address       String
  postalCode    String
  city          String

  wantsInstallation Boolean @default(false) // true = montering, false = kun levering
  note          String   @default("")

  // Prissammendrag (oprettet ud fra indstillinger paa bestillingstidspunktet)
  productsTotal     Float @default(0)
  installationTotal Float @default(0)
  estimatedTotal    Float @default(0)
  currency          String @default("DKK")

  items         OrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // FASE 1 (§3.3) - additive felter til den nye Lead/Order-model.
  // leadId er nullable indtil migreringsscriptet har koert (og indtil
  // Fase 3, hvor nye ordrer foerst begynder at faa en reel Lead).
  stage               OrderStage @default(KOE)
  leadId              String?    @unique
  lead                Lead?      @relation(fields: [leadId], references: [id])
  estReadyDate        DateTime?
  estReadyWeekLabel   String?
  promisedInstallDate DateTime?
  readyAt             DateTime?
  installedAt         DateTime?
  paymentStatus       String     @default("IKKE_SENDT") // IKKE_SENDT | SENDT | BETALT
  paidAt              DateTime?
  reviewLinkSentAt    DateTime?
  reviewReceived      Boolean    @default(false)
  // Ikke i spec'ens §3.3-model, men noedvendig for at kunne bevare
  // ANNULLERET-historik uden datatab naar OrderStatus paa sigt fjernes
  // (se §7 punkt 5 - "brug dit skoen her, men dokumentér valget").
  cancelledAt         DateTime?
  appointments        Appointment[]

  @@index([status])
  @@index([stage])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  roomName    String  // Rum navn (Kokken, Stue ...)
  productName String  // snapshot af produktnavn
  widthMm     Int
  heightMm    Int
  colorName   String  @default("")
  comment     String  @default("")

  isDoubleDoor Boolean @default(false)
  areaSqm      Float   @default(0) // afrundet m2 (op til naermeste 0,5)
  lineTotal    Float   @default(0) // pris for denne linje (ekskl. montering)

  createdAt   DateTime @default(now())
}

// Galleri (billeder og videoer). type = "image" | "video"
model GalleryItem {
  id        String  @id @default(cuid())
  type      String  @default("image")
  category  String  @default("vinduer") // vinduer | dore | dobbeltdore | plisse | videoer
  url       String
  thumbUrl  String  @default("")
  title     String  @default("")
  alt       String  @default("")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
}

// Fleksibel key/value store til indstillinger, priser, indhold og SEO.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Beskeder fra kontaktformularen
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Til generering af fortlobende ordrenumre pr. aar
model OrderCounter {
  year  Int @id
  count Int @default(0)
}

// FASE 1 (§3.5): nye kalenderfelter tilfoejet additivt ved siden af de
// eksisterende (day/time/customer/phone/address/note), som stadig er
// dem randevuAl() i ImalatCalc.tsx bruger indtil Fase 5. De nye felter
// er alle nullable, saa eksisterende raekker forbliver gyldige.
enum AppointmentType {
  MAALING
  INSTALLATION
}

enum AppointmentStatus {
  TENTATIVE
  CONFIRMED
}

enum Resource {
  BUILDER
  INSTALLER
}

model Appointment {
  id        String   @id @default(cuid())
  day       String   // "2026-05-12"
  time      String   // "17:00"
  customer  String
  phone     String   @default("")
  address   String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  // FASE 1 - nye felter, ubrugte af eksisterende kode indtil Fase 5.
  type      AppointmentType?
  status    AppointmentStatus?
  resource  Resource?
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])

  @@index([day])
  @@index([day, resource])
}
